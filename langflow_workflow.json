            "base_classes": ["Text"],
            "template": {
              "input_value": {
                "type": "str",
                "display_name": "Proposal Draft",
                "value": ""
              }
            },
            "outputs": [
              { "name": "text", "display_name": "Proposal Document", "types": ["Text"] }
            ]
          }
        }
      }
    ],
    "edges": [
