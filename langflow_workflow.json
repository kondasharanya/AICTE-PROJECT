  "meta": {
    "flow_stages": [
      {
        "step": 1,
        "name": "Startup Profile Input",
        "node_id": "startup_input",
        "description": "User enters startup details: name, domain, stage, location, DPIIT status, keywords, description"
      },
      {
        "step": 2,
        "name": "Grant Database",
        "node_id": "grant_database",
        "description": "All available grants loaded (BIRAC, DST, MeitY, AIM, AICTE, etc.) with eligibility metadata"
      },
      {
        "step": 3,
        "name": "Rule-Based Filter",
        "node_id": "rule_filter_prompt + ibm_granite_filter",
        "description": "Domain (+30), Stage (+25), Location (+20), DPIIT (+10), Keywords (+15) → grants scored 0-100"
      },
      {
        "step": 4,
        "name": "IBM Granite AI Scoring",
        "node_id": "ai_scoring_prompt + ibm_granite_scoring",
        "description": "Semantic deep scoring for grants with rule_score ≥ 30. Final = 40% rule + 60% AI"
      },
      {
        "step": 5,
        "name": "Ranked Results Output",
        "node_id": "output_ranked",
        "description": "Sorted list of top K grants with scores, explanations, strengths, and gaps"
      },
      {
        "step": 6,
        "name": "Proposal Generation",
        "node_id": "proposal_prompt + ibm_granite_proposal",
        "description": "IBM Granite writes a 9-section structured grant proposal for the top-matched grant"
      },
      {
        "step": 7,
        "name": "Proposal Draft Output",
        "node_id": "output_proposal",
        "description": "Final professional grant application document ready for submission"
      }
    ],
    "scoring_formula": "final_score = (rule_score × 0.4) + (ai_score × 0.6)",
    "rule_scoring_breakdown": {
      "domain_match": 30,
      "stage_match": 25,
      "location_match": 20,
      "dpiit_bonus": 10,
      "keyword_overlap": "3 per match, max 15"
    },
    "ibm_watsonx_config": {
      "model": "ibm/granite-13b-chat-v2",
      "url": "https://us-south.ml.cloud.ibm.com",
      "generation_endpoint": "/ml/v1/text/generation?version=2023-05-29",
      "iam_token_url": "https://iam.cloud.ibm.com/identity/token",
      "filter_node": { "max_new_tokens": 800, "temperature": 0.1 },
      "scoring_node": { "max_new_tokens": 1000, "temperature": 0.2 },
      "proposal_node": { "max_new_tokens": 1500, "temperature": 0.4 }
    },
    "required_env_vars": [
      "IBM_WATSONX_API_KEY",
      "IBM_WATSONX_PROJECT_ID",
      "IBM_WATSONX_URL",
      "IBM_GRANITE_MODEL_ID"
    ]
  }
}
